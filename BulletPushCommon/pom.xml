<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.example</groupId>
        <artifactId>BulletChatPush</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>BulletPushCommon</artifactId>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>3.8.0</version>
        </dependency>
        <!-- gRPC 生成类使用 javax.annotation.Generated，Java 17 不再内置该 API。 -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- 显式注册 Lombok，确保 Java 17 的增量编译也能生成 MessageBody 等模型的访问方法。 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version> <!-- 使用最新版本 -->
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>compile-custom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!--
                        构建时由 Maven 下载 protoc，避免依赖开发机 PATH 中的系统级安装。
                        当前开发环境为 Apple Silicon，因此明确使用 osx-aarch_64 工具包。
                    -->
                    <protocArtifact>com.google.protobuf:protoc:3.19.4:exe:osx-aarch_64</protocArtifact>
                    <!-- 指定你的proto文件目录 -->
                    <protoSourceRoot>${project.basedir}/src/main/java/com/GinElmaC/protoc</protoSourceRoot>
                    <!-- 生成 Java 代码的目录 -->
                    <outputDirectory>${project.basedir}/src/main/java</outputDirectory>
                    <clearOutputDirectory>false</clearOutputDirectory>
                    <!-- 指定与当前 macOS 架构匹配的 gRPC 代码生成插件。 -->
                    <pluginId>grpc-java</pluginId>
                    <pluginArtifact>io.grpc:protoc-gen-grpc-java:1.55.1:exe:osx-aarch_64</pluginArtifact>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
